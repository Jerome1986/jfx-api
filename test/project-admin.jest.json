{
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "(admin-project.*|renovation-project|employee-(project|quote|cancel)|appointment.*)\\.spec\\.ts$",
  "transform": { "^.+\\.tsx?$": "ts-jest" },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
